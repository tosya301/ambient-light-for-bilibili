{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.5.3.9",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Ambient light for Bilibili",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-ambient": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "开启 / 关闭 Bilibili 氛围光"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "shared.js",
        "player.js",
        "preview.js",
        "bars.js",
        "bar-effects.js",
        "content.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "zh_CN",
  "version_name": "0.5.3.9"
}
